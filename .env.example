# Copy to .env to override defaults. Every setting is optional.
LEXORA_STORAGE_DIR=storage
LEXORA_MAX_UPLOAD_MB=50
LEXORA_SCANNED_MIN_CHARS=30
LEXORA_SEED=42
LEXORA_OCR_ENABLED=true
LEXORA_OCR_LANG=eng
LEXORA_OCR_DPI=200
LEXORA_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
LEXORA_TABLES_ENABLED=true
LEXORA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LEXORA_EMBEDDING_BATCH_SIZE=32
LEXORA_RETRIEVAL_MODE=hybrid
LEXORA_INITIAL_TOP_K=20
LEXORA_FINAL_TOP_K=5
LEXORA_RRF_K=60
LEXORA_DENSE_MIN_SIMILARITY=0.0
LEXORA_CHUNK_MAX_CHARS=1000
LEXORA_CHUNK_OVERLAP=150
LEXORA_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LEXORA_RERANK_ENABLED=true
LEXORA_QUERY_DECOMPOSITION=true
#LEXORA_OLLAMA_BASE_URL=http://localhost:11434
LEXORA_OLLAMA_BASE_URL=http://host.docker.internal:11434
LEXORA_OLLAMA_MODEL=qwen3.5:9b
LEXORA_OLLAMA_TIMEOUT=600
LEXORA_OLLAMA_TEMPERATURE=0.1
LEXORA_OLLAMA_NUM_CTX=8192
LEXORA_OLLAMA_NUM_PREDICT=1024
LEXORA_OLLAMA_THINK=off
LEXORA_QUOTE_MATCH_MIN=0.85
LEXORA_ABSTAIN_RERANK_MIN=2.5
LEXORA_ABSTAIN_COVERAGE_MIN=0.32
LEXORA_HIGH_CONF_RERANK=6.0
LEXORA_MEDIUM_CONF_RERANK=2.5
LEXORA_VERIFY_RETRIES=1
LEXORA_MAX_DOCS_PER_CASE=5
